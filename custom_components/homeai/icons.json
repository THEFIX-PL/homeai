{
  "services": {
    "report_signal": {
      "service": "mdi:alert-plus-outline"
    },
    "clear_signal": {
      "service": "mdi:alert-remove-outline"
    },
    "acknowledge": {
      "service": "mdi:check"
    },
    "handle": {
      "service": "mdi:hand-back-right-outline"
    },
    "snooze": {
      "service": "mdi:bell-sleep-outline"
    },
    "dismiss": {
      "service": "mdi:close-circle-outline"
    },
    "send_digest": {
      "service": "mdi:text-box-outline"
    },
    "approve": {
      "service": "mdi:check-decagram-outline"
    },
    "deny": {
      "service": "mdi:close-octagon-outline"
    },
    "undo": {
      "service": "mdi:undo"
    },
    "plan_add": {
      "service": "mdi:calendar-plus"
    },
    "plan_remove": {
      "service": "mdi:calendar-remove"
    },
    "plan_skip": {
      "service": "mdi:calendar-arrow-right"
    },
    "presence_add": {
      "service": "mdi:account-clock"
    },
    "presence_remove": {
      "service": "mdi:account-cancel-outline"
    },
    "ask": {
      "service": "mdi:chat-question-outline"
    },
    "run_mission": {
      "service": "mdi:play-circle-outline"
    },
    "watch": {
      "service": "mdi:eye-check-outline"
    }
  },
  "entity": {
    "sensor": {
      "situations": {
        "default": "mdi:home-alert-outline"
      },
      "ai_cost_today": {
        "default": "mdi:cash-clock"
      },
      "ai_cost_month": {
        "default": "mdi:cash-multiple"
      },
      "next_plan_change": {
        "default": "mdi:calendar-arrow-right"
      }
    },
    "binary_sensor": {
      "attention_needed": {
        "default": "mdi:home-alert",
        "state": {
          "off": "mdi:home-outline"
        }
      }
    },
    "event": {
      "situation": {
        "default": "mdi:home-alert-outline"
      },
      "notification": {
        "default": "mdi:bell-ring-outline"
      }
    },
    "switch": {
      "notifications_paused": {
        "default": "mdi:bell-outline",
        "state": {
          "on": "mdi:bell-off-outline"
        }
      },
      "ai": {
        "default": "mdi:brain"
      },
      "vacation": {
        "default": "mdi:home-outline",
        "state": {
          "on": "mdi:palm-tree"
        }
      }
    },
    "calendar": {
      "plan": {
        "default": "mdi:calendar-clock"
      },
      "presence": {
        "default": "mdi:calendar-account"
      }
    },
    "conversation": {
      "assistant": {
        "default": "mdi:home-heart"
      }
    },
    "select": {
      "autonomy": {
        "default": "mdi:robot-outline",
        "state": {
          "observe": "mdi:eye-outline",
          "cautious": "mdi:tortoise",
          "balanced": "mdi:scale-balance",
          "bold": "mdi:rocket-launch-outline"
        }
      }
    },
    "number": {
      "ai_budget_monthly": {
        "default": "mdi:cash-lock"
      }
    }
  }
}
