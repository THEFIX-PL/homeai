{
  "services": {
    "report_signal": {
      "service": "mdi:alert-plus-outline"
    },
    "clear_signal": {
      "service": "mdi:alert-remove-outline"
    },
    "acknowledge": {
      "service": "mdi:check"
    },
    "handle": {
      "service": "mdi:hand-back-right-outline"
    },
    "snooze": {
      "service": "mdi:bell-sleep-outline"
    },
    "dismiss": {
      "service": "mdi:close-circle-outline"
    },
    "send_digest": {
      "service": "mdi:text-box-outline"
    },
    "approve": {
      "service": "mdi:check-decagram-outline"
    },
    "deny": {
      "service": "mdi:close-octagon-outline"
    },
    "undo": {
      "service": "mdi:undo"
    },
    "plan_add": {
      "service": "mdi:calendar-plus"
    },
    "plan_remove": {
      "service": "mdi:calendar-remove"
    },
    "plan_skip": {
      "service": "mdi:calendar-arrow-right"
    },
    "presence_add": {
      "service": "mdi:account-clock"
    },
    "presence_remove": {
      "service": "mdi:account-cancel-outline"
    }
  },
  "entity": {
    "sensor": {
      "situations": {
        "default": "mdi:home-alert-outline"
      }
    },
    "binary_sensor": {
      "attention": {
        "default": "mdi:home-alert",
        "state": {
          "off": "mdi:home-outline"
        }
      }
    },
    "event": {
      "situation": {
        "default": "mdi:home-alert-outline"
      },
      "notification": {
        "default": "mdi:bell-ring-outline"
      }
    },
    "switch": {
      "notifications_paused": {
        "default": "mdi:bell-outline",
        "state": {
          "on": "mdi:bell-off-outline"
        }
      }
    },
    "calendar": {
      "plan": {
        "default": "mdi:calendar-clock"
      },
      "presence": {
        "default": "mdi:calendar-account"
      }
    }
  }
}
